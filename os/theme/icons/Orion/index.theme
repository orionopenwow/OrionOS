[Icon Theme]
Name=Orion
Comment=OrionOS: Orion folders in violet, blue and cyan gradients; everything else from Papirus-Dark
Inherits=Papirus-Dark,Adwaita,hicolor
Example=folder
Directories=scalable/places,scalable/devices

[scalable/places]
Context=Places
Size=64
MinSize=16
MaxSize=512
Type=Scalable

[scalable/devices]
Context=Devices
Size=64
MinSize=16
MaxSize=512
Type=Scalable
