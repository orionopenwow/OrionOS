#!/bin/sh
# OrionOS typing other languages (fcitx5, started only once you add a second language; Ctrl+Space switches) and the
# emoji picker (Super+.).
#   orion-typing status [--json] | list | add ID | remove ID | emoji
# The logic lives in /opt/orion/everyone/orion_everyone.py (os/everyone/README.md).
LIB="${ORION_EVERYONE_LIB:-/opt/orion/everyone/orion_everyone.py}"
[ -r "$LIB" ] || LIB="$(dirname "$(readlink -f "$0")")/../../everyone/orion_everyone.py"
exec python3 "$LIB" typing "$@"
