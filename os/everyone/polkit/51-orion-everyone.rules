// OrionOS "Everyone can use it": anyone signed in at the computer (not the guest, not from far away) may ask for
// a guest session after they log out. Nothing else; adding people still needs the orion-admin password.
polkit.addRule(function(action, subject) {
    if (action.id == "ai.orion.everyone.guest" && subject.local && subject.active &&
        subject.user != "guest" && subject.user != "orion-agent") {
        return polkit.Result.YES;
    }
});
