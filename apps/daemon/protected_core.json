{
  "about": "Orion's protected core (docs/ORIONOS_AFTER_1_0_PLAN.md section 7, item 6). A self-made change that touches any of these can never be applied by the self-change flow without your phone's fingerprint or a boardroom signature, and never automatically. protected_core.py holds the same list in code; the two are joined, so deleting or emptying this file never makes anything less protected. A rule with 'symbols' protects those named parts of a Python file (plus its imports); a rule without protects the whole file. 'tamper' patterns flag any other file that tries to reach into the protected core.",
  "version": 1,
  "rules": [
    {"path": "apps/daemon/approval_queue.py", "area": "approvals", "why": "the approval system"},
    {"path": "apps/daemon/boardroom.py", "area": "approvals", "why": "the signer: signatures and verdicts",
     "symbols": ["SIG_DOMAIN", "MAX_CLOCK_SKEW_S", "PAIRING_TTL_S", "TaskType", "TASK_TYPES", "fingerprint",
                 "packet_hash", "signing_message", "verify_signature", "Boardroom.pubkey", "Boardroom.new_pairing_code",
                 "Boardroom.pair", "Boardroom.pending_fingerprint", "Boardroom.confirm_pending", "Boardroom.unpair",
                 "Boardroom.check_request", "Boardroom.propose", "Boardroom.verdict", "Boardroom._execute",
                 "build_remote_app"]},
    {"path": "apps/daemon/phones.py", "area": "approvals", "why": "the phone keys and their checks",
     "symbols": ["PAIRING_TTL_S", "MAX_CLOCK_SKEW_S", "fingerprint", "pairing_proof", "_load_p256", "verify_p256",
                 "PhoneRegistry.pair", "PhoneRegistry.pending_fingerprint", "PhoneRegistry.confirm",
                 "PhoneRegistry.remove", "PhoneRegistry.check"]},
    {"path": "apps/mobile/app/src/main/java/com/orion/mobile/Keys.kt", "area": "approvals", "why": "the phone's signing keys"},
    {"path": "apps/daemon/api_token.py", "area": "approvals", "why": "the daemon's key"},
    {"path": "apps/desktop/src-tauri/tauri.conf.json", "area": "approvals", "why": "what the desktop app may do on your PC"},
    {"path": "apps/desktop/src-tauri/capabilities/*", "area": "approvals", "why": "what the desktop app may do on your PC"},
    {"path": "apps/daemon/security.py", "area": "approvals", "why": "who may talk to the daemon"},
    {"path": "apps/daemon/main.py", "area": "approvals", "why": "the daemon's key check and health answer",
     "symbols": ["reject_foreign_origins", "health"]},
    {"path": "os/common/harden.sh", "area": "firewall", "why": "the firewall rules"},
    {"path": "os/common/*.nft*", "area": "firewall", "why": "the firewall rules"},
    {"path": "apps/daemon/injection_firewall.py", "area": "firewall", "why": "the injection firewall"},
    {"path": "apps/daemon/capture_privacy.py", "area": "privacy", "why": "the recorder's privacy rules"},
    {"path": "apps/daemon/skills_recorder.py", "area": "privacy", "why": "the recorder's private-field rules",
     "symbols": ["looks_secret", "SENSITIVE_PAGE", "CARD_HINT", "CODE_HINT", "PASSWORD_HINT", "sensitive_field_reason",
                 "PRIVATE_PARAM", "scrub_url", "page_looks_sensitive", "normalize_events"]},
    {"path": "apps/extension/recorder.js", "area": "privacy", "why": "the browser recorder's skip rules"},
    {"path": "apps/daemon/self_evolve.py", "area": "self-change gate", "why": "the self-change gate"},
    {"path": "apps/daemon/self_program.py", "area": "self-change gate", "why": "the self-change gate"},
    {"path": "apps/daemon/protected_core.py", "area": "self-change gate", "why": "the protected-core list"},
    {"path": "apps/daemon/protected_core.json", "area": "self-change gate", "why": "the protected-core list"},
    {"path": "apps/daemon/orion_layer.py", "area": "self-change gate", "why": "undo and the start-up guard"},
    {"path": "apps/daemon/self_levels.py", "area": "self-change gate", "why": "the permission levels and their ceilings"},
    {"path": "apps/daemon/freeze.py", "area": "self-change gate", "why": "the kill switch"},
    {"path": "os/safety/orion-self-gate", "area": "self-change gate", "why": "the system's self-change gate"},
    {"path": "os/lab/bin/orion-self-gate", "area": "self-change gate", "why": "the system's self-change gate"},
    {"path": "scripts/run-daemon.mjs", "area": "self-change gate", "why": "restart and automatic undo"},
    {"path": "apps/daemon/tests/test_protected_core.py", "area": "self-change gate", "why": "the proof the gate holds"},
    {"path": "apps/daemon/tests/test_self_program.py", "area": "self-change gate", "why": "the proof the gate holds"}
  ],
  "tamper": [
    {"pattern": "(?<![\\w.])(approval_queue|boardroom|phones|api_token|security|injection_firewall|capture_privacy|skills_recorder|self_evolve|self_program|protected_core|orion_layer|self_levels|freeze)\\.[A-Za-z_][A-Za-z0-9_]*\\s*=(?!=)", "why": "replaces part of the protected core from outside"},
    {"pattern": "setattr\\(\\s*(approval_queue|boardroom|phones|api_token|security|injection_firewall|capture_privacy|skills_recorder|self_evolve|self_program|protected_core|orion_layer|self_levels|freeze)\\b", "why": "replaces part of the protected core from outside"},
    {"pattern": "\\.orion-signing|protected_core\\.json|self-levels\\.json|self_levels\\.json|probation\\.json", "why": "touches the signer's keys or the gate's own files"},
    {"pattern": "\\borion_layer\\.(set_gen|rollback|set_probation|save_history|update_swap|new_gen)\\b", "why": "changes the undo history"},
    {"pattern": "ORION_LAYER_MODE|ORION_SELF_LEVELS_ADMIN|ORION_FREEZE_MARK", "why": "changes how the gate is set up"}
  ]
}
