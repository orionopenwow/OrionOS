# Copy to .env and fill in what you need. Everything is optional.

# --- Server ---
ORION_HOST=127.0.0.1
ORION_PORT=9120

# --- Perceptual capture ---
ORION_CAPTURE_ENABLED=true
ORION_CAPTURE_INTERVAL=5
ORION_PHASH_THRESHOLD=5
ORION_MONITOR_INDEX=1
# Full path if tesseract is not on PATH, e.g. C:\Program Files\Tesseract-OCR\tesseract.exe
TESSERACT_CMD=

# --- Memory ---
ORION_DATA_DIR=~/.orion
# auto | openai | ollama | st | hash
EMBEDDING_BACKEND=auto
OLLAMA_EMBED_MODEL=nomic-embed-text
ST_MODEL=all-MiniLM-L6-v2
OCR_RETENTION_DAYS=7
CONSOLIDATION_HOUR=3

# --- LLMs ---
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b
# Keep OLLAMA_MODEL loaded (pauses on battery below 30% on Linux laptops). See MCP.md.
ORION_OLLAMA_WARM=true
ORION_OLLAMA_WARM_INTERVAL=240
ORION_OLLAMA_KEEP_ALIVE=15m
ORION_SLM_ROUTER=true
# auto | anthropic | openai
CLOUD_PROVIDER=auto
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o
OPENAI_EMBED_MODEL=text-embedding-3-small

# Proactively analyze every screen delta with the LLM (token-hungry).
ORION_AUTO_ANALYZE=false
ORION_AUTO_ANALYZE_COOLDOWN=90

# --- Discord Monitor & Game Bug Tracker ---
DISCORD_TOKEN=
# Comma-separated channel IDs; empty = DMs + mentions only
DISCORD_CHANNEL_IDS=
DISCORD_GAME_NAME=Starfall Odyssey
DISCORD_BUG_CHANNEL_IDS=

# --- Telegram Bot ---
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ENABLED=true

# --- Gemini API ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# --- Voice & Personality ---
ORION_PERSONALITY=concise_companion
TTS_VOICE_ID=
TTS_RATE=185
TTS_VOLUME=0.9


# ======================= V2.0 =======================
# --- Autonomous Discord Prompt Detector & Approval Queue ---
DISCORD_TRIAGE_ENABLED=true
# Channel names (matched even with emoji prefixes like "🐛│bug-reports") and/or explicit IDs
DISCORD_TRIAGE_CHANNELS=general,realm-pitches,bug-reports,support
DISCORD_TRIAGE_CHANNEL_IDS=
# Tier 1 local classifier (defaults to OLLAMA_MODEL); small models like llama3.2:3b or phi3 work well
TRIAGE_MODEL=
# Tier 2 drafting model (defaults to OPENAI_MODEL; falls back to Anthropic / Gemini / Ollama)
DRAFT_MODEL=
# How many past approved edits to show the drafter as few-shot examples
ALIGNMENT_EXAMPLES=5

# --- Unified Comms Hub ---
COMMS_HISTORY_PER_THREAD=200
# Optional: mirror your real personal Telegram DMs (https://my.telegram.org -> API development tools).
# Then run once:  cd apps\daemon && .venv\Scripts\python telegram_login.py
TELEGRAM_API_ID=
TELEGRAM_API_HASH=

# --- Ambient Pacing Tracker ---
PACING_ENABLED=true
PACING_LIMIT_MINUTES=90
# Minutes of no screen/input activity that count as a real break (resets the arc)
PACING_BREAK_RESET_MINUTES=5
PACING_SNOOZE_MINUTES=15

# --- Voice-to-Patch Self-Coding (Deep mode) ---
SELF_EVOLVE_ENABLED=true
# Defaults to the repo this daemon lives in
ORION_REPO_ROOT=

# --- Security ---
# Browser pages may only reach the daemon from these origins (the HUD on :1420, Tauri, and browser
# extensions are always allowed). Add more comma-separated origins here if you serve the HUD elsewhere.
ORION_ALLOWED_ORIGINS=
