{
  "$schema": "vscode://schemas/color-theme",
  "name": "Event Horizon",
  "type": "dark",
  "semanticHighlighting": true,
  "semanticTokenColors": {
    "function": "#00E5FF",
    "method": "#00E5FF",
    "class": "#9DB0FF",
    "interface": "#9DB0FF",
    "type": "#9DB0FF",
    "enumMember": "#FFC66B",
    "property": "#7FF2FF",
    "parameter": {
      "foreground": "#C3C9EE",
      "italic": true
    },
    "namespace": "#9DB0FF",
    "macro": "#FF5C8A",
    "variable.readonly": "#FFDCA0"
  },
  "colors": {
    "focusBorder": "#7C5CFF99",
    "foreground": "#D8DEFF",
    "descriptionForeground": "#8A90B8",
    "errorForeground": "#FF5C8A",
    "icon.foreground": "#A3AAD6",
