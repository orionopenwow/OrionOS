#!/usr/bin/env python3
"""orion-a11y-check: is the screen reader (Orca) able to work in this Sway session, with the Orion HUD?

    orion-a11y-check [--json]   checks, in plain words; exit 0 when Orca can work here
    orion-a11y-check start      accessibility bus up, then Orca (orion-access screen-reader on uses this)
    orion-a11y-check bus-up     accessibility bus up only
    orion-a11y-check fix        take NO_AT_BRIDGE / GTK_A11Y=none out of ~/.config/orion/session.env
The logic is os/desktop/orion_a11y.py.
"""
from __future__ import annotations

import json
import os
import shutil
import subprocess
import sys
from pathlib import Path

HERE = Path(__file__).resolve()
for _d in (os.environ.get("ORION_DESKTOP_DIR", ""), "/opt/orion/desktop", str(HERE.parent.parent.parent / "desktop")):
    if _d and (Path(_d) / "orion_a11y.py").is_file():
        sys.path.insert(0, _d)
        break
import orion_a11y as A  # noqa: E402

SESSION_ENV = Path(os.environ.get("ORION_CONF_DIR", str(Path.home() / ".config" / "orion"))) / "session.env"
ACCESS = SESSION_ENV.parent / "access.json"


def run(argv: list[str]) -> tuple[int, str]:
    try:
        p = subprocess.run(argv, capture_output=True, text=True, timeout=10, stdin=subprocess.DEVNULL)
        return p.returncode, p.stdout
    except (OSError, subprocess.TimeoutExpired):
        return 127, ""


def has(name: str) -> bool:
    return (os.path.isabs(name) and os.access(name, os.X_OK)) or shutil.which(name) is not None


def read(p: Path) -> str:
    try:
        return p.read_text(encoding="utf-8")
    except OSError:
        return ""


def reader_on() -> bool:
    try:
        return bool(json.loads(read(ACCESS) or "{}").get("screen_reader"))
    except ValueError:
        return False


def main(argv: list[str]) -> int:
    cmd = argv[0] if argv and not argv[0].startswith("--") else "check"
    if cmd == "bus-up":
        ok, why = A.bus_up(run)
        print(why if ok else f"The accessibility bus didn't start: {why}")
        return 0 if ok else 1
    if cmd == "start":
        ok, why = A.bus_up(run)
        if not has("orca"):
            print("Orca isn't installed.")
            return 1
        env = {k: v for k, v in os.environ.items() if k not in A.DISABLERS}
        subprocess.Popen(["orca", "--replace"], env=env, stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL,
                         stderr=subprocess.DEVNULL, start_new_session=True)
        print("Orca started." + ("" if ok else f" (Warning: {why}; some apps may stay silent.)"))
        return 0
    if cmd == "fix":
        text = read(SESSION_ENV)
        new = A.strip_disablers(text)
        if new != text:
            SESSION_ENV.write_text(new, encoding="utf-8")
            print("Fixed. Log out and back in.")
        else:
            print("Nothing to fix.")
        return 0
    rows = A.check(dict(os.environ), run, has, read(SESSION_ENV), reader_on(),
                   run(["pgrep", "-x", "orca"])[0] == 0, A.hud_on_bus())
    ok, words = A.verdict(rows)
    if "--json" in argv:
        print(json.dumps({"ok": ok, "words": words, "rows": rows}))
    else:
        for r in rows:
            print(f"[{'ok' if r['ok'] else ('!!' if r['needed'] else 'note')}] {r['text']}"
                  + (f"  Fix: {r['fix']}" if r["fix"] else ""))
        print(words)
    return 0 if ok else 1


if __name__ == "__main__":
    sys.exit(main(sys.argv[1:]))
