#!/bin/sh
# OrionOS: more than one person. Who has an account here, and checking a new login name. Adding a person and the
# guest account are in Settings > Users; those changes ask for the orion-admin password.
#   orion-people status [--json] | check-name LOGIN
# The logic lives in /opt/orion/everyone/orion_everyone.py (os/everyone/README.md).
LIB="${ORION_EVERYONE_LIB:-/opt/orion/everyone/orion_everyone.py}"
[ -r "$LIB" ] || LIB="$(dirname "$(readlink -f "$0")")/../../everyone/orion_everyone.py"
exec python3 "$LIB" people "$@"
