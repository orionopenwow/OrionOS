#!/bin/sh
# OrionOS accessibility: screen reader (Super+Alt+S), on-screen keyboard (Super+Alt+K), high contrast (Super+Alt+C),
# bigger text, screen zoom (Super+Alt+= / Super+Alt+- / Super+Alt+0). "orion-access" alone shows what is on.
#   orion-access status [--json] | session | screen-reader|keyboard|contrast on|off|toggle | text-size 1-2
#               | screen-size 1-2|off | hud-zoom N | zoom in|out|reset | wizard
# The logic lives in /opt/orion/everyone/orion_everyone.py (os/everyone/README.md).
LIB="${ORION_EVERYONE_LIB:-/opt/orion/everyone/orion_everyone.py}"
[ -r "$LIB" ] || LIB="$(dirname "$(readlink -f "$0")")/../../everyone/orion_everyone.py"
exec python3 "$LIB" access "$@"
