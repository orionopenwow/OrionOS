# OrionOS lab daemon settings. Your own overrides and API keys go in ~/.config/orion/daemon.env
# (that file wins; it is readable only by you).
ORION_HOST=127.0.0.1
ORION_PORT=9120
# Boardroom endpoint: reachable only from the boardroom VM (10.77.0.11) and Tailscale (see ufw).
ORION_BOARDROOM_BIND=0.0.0.0
ORION_BOARDROOM_PORT=9121
# Stand-in CFO/CTO/Community agents propose a decision every N minutes (0 = off).
ORION_BOARDROOM_SIM_MINUTES=10
# Ollama on the Windows host: VirtualBox maps the host's 127.0.0.1 to 10.77.0.2 on OrionNet.
OLLAMA_URL=http://10.77.0.2:11434
ORION_REPO_ROOT=/home/orion/projects
# Screen reading (OCR) is opt-in: first-run asks, Settings > Privacy switches it (your choice goes in
# ~/.config/orion/daemon.env). Password managers, banking, private windows and the lock screen are never read.
ORION_CAPTURE_ENABLED=false
# The daemon's code is installed read-only in /opt/orion; Talk-to-Develop stays off on OrionOS v0.1.
SELF_EVOLVE_ENABLED=false
# First-run setup agent: proposes installing your apps and getting your project code (each needs your approval).
ORION_SETUP_AGENT=1
