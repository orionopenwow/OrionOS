#!/bin/sh
# Root side of first-run's "Choose your password" (os/lab/bin/orion-firstrun runs it with pkexec, in its terminal).
# It sets the password of the person who ran it, and only while that account has none yet: a password protects
# the laptop and unlocks the lock screen. Changing an existing password is plain `passwd` (it asks the old one).
# After the password is set:
#   - the lock screen works (Super+L, closing the lid, 5 minutes away)
#   - on a computer OrionOS is installed on, the login screen asks for it from now on (orion-login-mode password);
#     the VM lab and the USB stick keep starting straight into Orion (the stick's vault passphrase protects it)
set -u
[ "$(id -u)" -eq 0 ] || { echo "Run me with pkexec."; exit 1; }
uid="${PKEXEC_UID:-}"
case "$uid" in ''|*[!0-9]*) echo "Run me with pkexec, from your own account."; exit 1 ;; esac
[ "$uid" -ge 1000 ] || { echo "Only for people's accounts."; exit 1; }
user="$(getent passwd "$uid" | cut -d: -f1)"
home="$(getent passwd "$uid" | cut -d: -f6)"
[ -n "$user" ] || { echo "Unknown account."; exit 1; }
if [ "$(passwd -S "$user" 2>/dev/null | awk '{print $2}')" = P ]; then
  echo "You already have a password. To change it, run: passwd"
  exit 3
fi
echo "Type the password twice. Nothing shows while you type; that's normal."
tries=0
until passwd "$user"; do
  tries=$((tries + 1))
  [ "$tries" -ge 3 ] && { echo "No password was set."; exit 1; }
  echo "Try again."
done
if [ -n "$home" ] && [ -d "$home" ]; then
  install -d -o "$user" -g "$user" "$home/.config" "$home/.config/orion"
  touch "$home/.config/orion/lock-ready" && chown "$user:$user" "$home/.config/orion/lock-ready"
fi
profile="$(cat /etc/orion/profile 2>/dev/null)"
login_user="$(sed -n 's/^LOGIN_USER=//p' /etc/orion/login.conf 2>/dev/null | tail -n1)"
if [ "$profile" = baremetal ] && [ "$user" = "${login_user:-orion}" ] && [ -x /opt/orion/greeter/orion-login-mode ]; then
  /opt/orion/greeter/orion-login-mode password >/dev/null 2>&1 && \
    echo "From now on the login screen asks for this password when the computer starts."
fi
echo "Done. Your password also unlocks the lock screen (Super+L)."
