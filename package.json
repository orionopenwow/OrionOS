{
  "name": "orion",
  "version": "2.0.0",
  "private": true,
  "description": "Orion \u2014 autonomous desktop agent & intelligence hub",
  "workspaces": [
    "apps/desktop",
    "packages/*"
  ],
  "scripts": {
    "setup": "npm install && npm run setup:daemon",
    "setup:daemon": "node scripts/setup-daemon.mjs",
    "setup:daemon:full": "node scripts/setup-daemon.mjs --optional",
    "dev": "concurrently -k -n daemon,desktop -c magenta,cyan \"npm:dev:daemon\" \"npm:dev:desktop\"",
    "dev:web": "concurrently -k -n daemon,web -c magenta,cyan \"npm:dev:daemon\" \"npm run dev:web -w @orion/desktop\"",
    "dev:daemon": "node scripts/run-daemon.mjs",
    "dev:desktop": "npm run dev -w @orion/desktop",
    "build": "npm run build -w @orion/desktop",
    "build:web": "npm run build:web -w @orion/desktop",
    "build:demo": "npm run build:demo -w @orion/desktop",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build:app": "npm run build -w @orion/desktop",
    "release": "node scripts/release.mjs",
    "test:daemon": "node scripts/test-daemon.mjs",
    "render:boot": "node os/theme/boot/render-frames.mjs --sheet /tmp/orion-boot-sheet.png",
    "prepare": "node scripts/secret-shield/install-hooks.mjs --quiet",
    "secrets:scan-history": "node scripts/secret-shield/scan-history.mjs",
    "rules:sync": "node scripts/rulebook/sync.mjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.0",
    "typescript": "^5.6.3"
  },
  "engines": {
    "node": ">=20"
  }
}
