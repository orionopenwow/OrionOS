[Unit]
Description=Orion daemon (the OrionOS brain)
Documentation=file:///opt/orion/daemon
# If it keeps stopping (5 times in 5 minutes), systemd stops restarting it and orion-daemon-gave-up.service says so
# in plain words (a notification pointing at the Rescue panel). `orion-ctl restart` or logging in again tries anew.
StartLimitIntervalSec=300
StartLimitBurst=5
OnFailure=orion-daemon-gave-up.service

[Service]
WorkingDirectory=/opt/orion/daemon
EnvironmentFile=/etc/orion/daemon.env
EnvironmentFile=-%h/.config/orion/daemon.env
Environment=PYTHONDONTWRITEBYTECODE=1
ExecStart=/opt/orion/venv/bin/python /opt/orion/daemon/main.py
Restart=always
RestartSec=3

[Install]
WantedBy=default.target
