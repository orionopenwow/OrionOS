{
  "name": "@orion/desktop",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "build": "tauri build",
    "dev:web": "vite",
    "build:web": "tsc -b && vite build",
    "build:demo": "vite build --mode demo --base ./ --outDir ../../docs/app --emptyOutDir",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/reactions.test.ts tests/look.test.ts tests/guide.test.ts tests/menu.test.ts tests/testflow.test.ts tests/demo.test.ts tests/windowRect.test.ts tests/focus.test.ts",
    "test:demo-smoke": "node ../../scripts/capture-screenshots.mjs --smoke",
    "tauri": "tauri",
    "build:desktop-assets": "node ../../scripts/stage-daemon.mjs && npm run build:web"
  },
  "dependencies": {
    "@fontsource-variable/figtree": "^5.3.0",
    "@fontsource-variable/martian-mono": "^5.3.0",
    "@fontsource-variable/unbounded": "^5.3.0",
    "@fontsource/inter": "^5.1.0",
    "@fontsource/nunito": "^5.1.0",
    "@orion/shared-types": "*",
    "@tauri-apps/api": "^2.1.1",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.3",
    "@types/three": "^0.186.0",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.460.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.186.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.1.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.4.49",
    "tailwindcss": "^3.4.15",
    "typescript": "^5.6.3",
    "vite": "^5.4.11"
  }
}
