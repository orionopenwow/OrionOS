#!/usr/bin/env python3
"""orion-self-gate KIND: may this kind of self-change run by itself right now? (apps/daemon/self_levels.py)

Exit 0 = yes (level 2 "tell me after" or 3 "just do it", and Orion isn't frozen); exit 1 = no (ask first, or
frozen). Used as ExecCondition= for Ubuntu's apt-daily-upgrade.service, so unattended-upgrades only installs
security updates by itself when you allow it.

Reads the same files as the daemon: /etc/orion/self-levels.json (set with the admin password) and the session
user's ~/.orion/self_levels.json. This runs as root, and the user's file can be written by any program the user
runs, so that file may only make things SAFER here (review: "admin file must win"):

    allowed = the admin file's level for the kind, or the plan's default when the admin file doesn't set it
    level   = min(allowed, the user's level)   when the user's file sets one, else allowed

Raising a kind above its default for this gate therefore needs the admin password (orion-self-helper level ...).
"""
import json
import os
import pwd
import sys

DEFAULTS = {"security_update": 3, "app_update": 2, "routine_fix": 3, "ai_model": 2, "system_version": 1,
            "ui_code": 1, "daemon_code": 1, "firmware": 1, "protected_core": 1}
MAX = {"security_update": 3, "app_update": 3, "routine_fix": 3, "ai_model": 3, "ui_code": 2}


def entries(path):
    try:
        d = json.load(open(path, encoding="utf-8"))
    except (OSError, ValueError):
        return {}
    d = d.get("levels", d) if isinstance(d, dict) else {}
    return d if isinstance(d, dict) else {}


def user_dirs():
    out = [os.environ.get("ORION_DATA_DIR", "")]
    user = os.environ.get("ORION_USER", "orion")
    try:
        out.append(os.path.join(pwd.getpwnam(user).pw_dir, ".orion"))
    except KeyError:
        pass
    return [d for d in out if d]


def frozen():
    if os.path.exists(os.environ.get("ORION_FREEZE_MARK", "/etc/orion/frozen")):
        return True
    return any(os.path.exists(os.path.join(d, "frozen")) for d in user_dirs())


def _level_in(path, kind):
    e = entries(path).get(kind)
    if not isinstance(e, dict):
        return None
    try:
        return int(e.get("level"))
    except (TypeError, ValueError):
        return None


def level(kind):
    admin = _level_in(os.environ.get("ORION_SELF_LEVELS_ADMIN", "/etc/orion/self-levels.json"), kind)
    allowed = admin if admin is not None else DEFAULTS.get(kind, 1)
    best = allowed
    for d in user_dirs():
        mine = _level_in(os.path.join(d, "self_levels.json"), kind)
        if mine is not None:
            best = min(best, mine)          # the user's own file can lower, never raise
    return max(1, min(best, MAX.get(kind, 1)))


def main(argv):
    kind = argv[1] if len(argv) > 1 else "security_update"
    if frozen():
        print("Orion is frozen: not running by itself.")
        return 1
    lv = level(kind)
    if lv >= 2:
        return 0
    print(f"{kind} is set to 'always ask': not running by itself.")
    return 1


if __name__ == "__main__":
    sys.exit(main(sys.argv))
