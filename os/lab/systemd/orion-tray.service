# OrionOS: App tray (orion-tray), started with the Sway session (sway-session.target).
[Unit]
Description=App tray (orion-tray)
PartOf=sway-session.target
After=sway-session.target
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
ExecStart=/usr/bin/env orion-tray
Restart=on-failure
RestartSec=2
